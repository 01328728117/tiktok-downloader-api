# --- App ---
APP_NAME=TikTok Downloader API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Auth ---
# Comma-separated list. Leave empty to disable API key auth.
API_KEYS=changeme-dev-key
API_KEY_HEADER=X-API-Key

# --- CORS ---
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Rate limiting ---
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true

# --- Redis / Cache ---
# Leave empty to use in-memory cache + eager Celery (single-process mode).
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
CACHE_PREFIX=tiktok-dl:

# --- Celery ---
# If empty, the values default to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=100

# --- yt-dlp ---
YTDLP_SOCKET_TIMEOUT=20
YTDLP_RETRIES=3
YTDLP_USER_AGENT=Mozilla/5.0 (Linux; Android 10; SM-G973F) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36

# --- Docs ---
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
